<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/select_folder_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Current Path Breadcrumb -->
    <TextView
        android:id="@+id/tvPickerCurrentPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_folder_badge"
        android:ellipsize="start"
        android:maxLines="2"
        android:padding="8dp"
        android:textColor="@color/accent"
        android:textSize="12sp" />

    <!-- Folder List -->
    <ListView
        android:id="@+id/lvPickerFolders"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPickerCancel"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnPickerSelectCurrent"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_button_accent_square"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/select_current_folder"
            android:textColor="@color/text_on_primary" />
    </LinearLayout>

</LinearLayout>
