<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/window_background"
        android:orientation="vertical">

        <!-- Top Action Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/action_bar_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingLeft="4dp"
            android:paddingEnd="8dp"
            android:paddingRight="8dp">

            <!-- Slide-in Drawer Toggle Button (Hamburger) -->
            <ImageView
                android:id="@+id/ivNavDrawer"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="Menu"
                android:padding="8dp"
                app:tint="@color/action_bar_icon"
                android:src="@drawable/ic_menu_bars" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:text="@string/library_title"
                android:textColor="@color/action_bar_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Refresh Button (Visible in Server view or on demand) -->
            <ImageView
                android:id="@+id/ivHeaderRefresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/refresh"
                android:padding="8dp"
                android:visibility="gone"
                app:tint="@color/action_bar_icon"
                android:src="@drawable/ic_refresh" />

            <ImageView
                android:id="@+id/ivHeaderMenu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/settings_title"
                android:padding="8dp"
                app:tint="@color/action_bar_icon"
                android:src="@drawable/ic_more_vert" />

        </LinearLayout>

        <!-- Main Grid Content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ListView
                android:id="@+id/lvAudiobooks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:divider="@color/divider"
                android:dividerHeight="1dp"
                android:paddingBottom="72dp" />

            <!-- Server Audiobooks Thumbnail Grid View -->
            <GridView
                android:id="@+id/gvServerAudiobooks"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:columnWidth="105dp"
                android:gravity="center"
                android:horizontalSpacing="6dp"
                android:numColumns="auto_fit"
                android:padding="6dp"
                android:paddingBottom="72dp"
                android:stretchMode="columnWidth"
                android:verticalSpacing="6dp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/pbLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Local Library Empty State -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_folder" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/no_audiobooks_found"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCurrentFolderEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnEmptyChooseFolder"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_settings_button"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:text="@string/change_folder"
                    android:textColor="@color/settings_button_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Server View Empty / Disconnected State -->
            <LinearLayout
                android:id="@+id/layoutServerEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivServerEmptyIcon"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/ic_cloud"
                    app:tint="@color/accent" />

                <TextView
                    android:id="@+id/tvServerEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/server_not_configured_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvServerEmptyDesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/server_not_configured_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnServerEmptyAction"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_button_accent"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="@string/server_connect_button"
                    android:textColor="@color/text_on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/fabPlay"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:background="@drawable/bg_play_circle"
                android:contentDescription="@string/play"
                android:elevation="6dp"
                android:padding="15dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                app:tint="@color/text_on_primary" />

        </FrameLayout>

        <!-- Persistent Mini Player Bar (Castaway inspired) -->
        <LinearLayout
            android:id="@+id/layoutMiniPlayer"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:background="@drawable/bg_mini_player"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivMiniCover"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@color/mini_player_cover_bg"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_book_placeholder" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMiniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mini_player_text"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMiniSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/mini_player_subtitle"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivMiniPlayPause"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="?android:attr/selectableItemBackground"
                android:contentDescription="@string/play"
                android:padding="6dp"
                android:scaleType="fitCenter"
                app:tint="@color/mini_player_control"
                android:src="@drawable/ic_play" />

        </LinearLayout>

    </LinearLayout>

    <!-- Slide-in Navigation Drawer -->
    <include layout="@layout/layout_nav_drawer" />

</androidx.drawerlayout.widget.DrawerLayout>
